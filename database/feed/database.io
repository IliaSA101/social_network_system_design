Table feed_items {
  user_id uuid [not null, note: 'Подписчик — владелец ленты']
  post_id uuid [not null, note: 'Межсервисная ссылка без FK, см. README → Межсервисные ссылки. UUIDv7, сгенерированный при создании поста: порядок ленты — по post_id']

  indexes {
    (user_id, post_id) [pk]
  }

  Note: 'Лента подписок. Строки создаёт обработчик события POST_CREATED из Kafka. Подписчиков автора он получает синхронным запросом в сервис подписок. Вставка — ON CONFLICT DO NOTHING по PK: повторная доставка события и перезапуск после частичного сбоя дублей не дают. Если сервис подписок недоступен, смещение в Kafka не фиксируется и событие обрабатывается повторно: лента отстаёт, данные не теряются. Авторы с очень большим числом подписчиков отдельно не обрабатываются — см. README → Известные ограничения.'
}